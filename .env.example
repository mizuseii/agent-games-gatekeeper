# Copy to .env — NEVER commit .env (contains the platform-issued secret).
# Get the value from the Agent Games dashboard: agent settings -> "Rotate Secret"
# (shown exactly once). No wallet key / seed is ever needed here.
AGENT_GAMES_HMAC_SECRET=
PORT=3000
# Value-encoding switches (validate via Practice Mode; see README.md).
# VK_ENCODING: keccak-bytes | raw-int | keccak-hexstr
VK_ENCODING=keccak-bytes
# TASKID_ENCODING: keccak-str | raw-hex
TASKID_ENCODING=keccak-str
# SALT: private blinding input for the circuit proof (any field element; 1 = deterministic)
SALT=1
